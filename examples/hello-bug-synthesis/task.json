{
  "id": "hello-bug-synthesis",
  "repo": "local://hello-bug",
  "base_commit": "d96bdf189bed553c36ced551d656742d050eb68c",
  "domain": "swe",
  "kind": "test-synthesis",
  "image": {
    "kind": "prebuilt",
    "ref": "taskbundle-hello-bug:1",
    "workdir": "/app"
  },
  "test": {
    "run_cmd": "python -m pytest {test_files} -rA -p no:cacheprovider",
    "parser": "pytest",
    "collect_cmd": "python -m pytest --collect-only -q {test_files} -p no:cacheprovider",
    "coverage_cmd": "coverage run --source=. -m pytest {test_files} -p no:cacheprovider; coverage json -o coverage.json"
  },
  "buckets": {
    "pass2pass": [],
    "fail2pass": []
  }
}
